{
  "description": "Row and condition cases that frontend/src/features/scan/filterExpressionEvaluator.js and stockscreen-mcp/src/stockscreen_mcp/screens.py must both match.",
  "conditions": [
    { "row": { "rs_rating": 80 }, "condition": { "field": "rs_rating", "kind": "range", "min": 70, "max": null }, "matches": true },
    { "row": { "rs_rating": 70 }, "condition": { "field": "rs_rating", "kind": "range", "min": 70, "max": null }, "matches": true },
    { "row": { "rs_rating": 69 }, "condition": { "field": "rs_rating", "kind": "range", "min": 70, "max": null }, "matches": false },
    { "row": { "stage": 3 }, "condition": { "field": "stage", "kind": "range", "min": 2, "max": 2 }, "matches": false },
    { "note": "Missing and null values never pass a range, even an open one.", "row": {}, "condition": { "field": "rs_rating", "kind": "range", "min": null, "max": null }, "matches": false },
    { "row": { "rs_rating": null }, "condition": { "field": "rs_rating", "kind": "range", "min": 0, "max": null }, "matches": false },
    { "note": "JS compares a non-numeric string to a number as NaN (false), so neither bound rejects it.", "row": { "rs_rating": "n/a" }, "condition": { "field": "rs_rating", "kind": "range", "min": 70, "max": 99 }, "matches": true },
    { "note": "JS converts numeric strings for < and >.", "row": { "rs_rating": "50" }, "condition": { "field": "rs_rating", "kind": "range", "min": 70, "max": null }, "matches": false },
    { "row": { "rs_rating": "80" }, "condition": { "field": "rs_rating", "kind": "range", "min": 70, "max": null }, "matches": true },
    { "note": "Booleans need a real boolean, not a truthy string or number.", "row": { "ma_alignment": true }, "condition": { "field": "ma_alignment", "kind": "boolean", "value": true }, "matches": true },
    { "row": { "ma_alignment": "true" }, "condition": { "field": "ma_alignment", "kind": "boolean", "value": true }, "matches": false },
    { "row": { "ma_alignment": 1 }, "condition": { "field": "ma_alignment", "kind": "boolean", "value": true }, "matches": false },
    { "row": { "flag": true }, "condition": { "field": "flag", "kind": "boolean", "value": 1 }, "matches": false },
    { "note": "Categorical include and exclude; exclude lets missing values through.", "row": { "p": "cup" }, "condition": { "field": "p", "kind": "categorical", "values": ["cup"], "mode": "include" }, "matches": true },
    { "row": { "p": null }, "condition": { "field": "p", "kind": "categorical", "values": ["cup"], "mode": "include" }, "matches": false },
    { "row": { "p": "cup" }, "condition": { "field": "p", "kind": "categorical", "values": ["cup"], "mode": "exclude" }, "matches": false },
    { "row": {}, "condition": { "field": "p", "kind": "categorical", "values": ["cup"], "mode": "exclude" }, "matches": true },
    { "note": "Strict equality: true is not 1 in includes().", "row": { "p": 1 }, "condition": { "field": "p", "kind": "categorical", "values": [true], "mode": "include" }, "matches": false },
    { "row": { "p": true }, "condition": { "field": "p", "kind": "categorical", "values": [1], "mode": "include" }, "matches": false },
    { "row": { "p": 1.0 }, "condition": { "field": "p", "kind": "categorical", "values": [1], "mode": "include" }, "matches": true },
    { "row": { "group": "Semiconductors" }, "condition": { "field": "group", "kind": "text", "pattern": "SEMI" }, "matches": true },
    { "row": { "group": null }, "condition": { "field": "group", "kind": "text", "pattern": "semi" }, "matches": false },
    { "note": "Field aliases used by the published presets.", "row": { "current_price": 12 }, "condition": { "field": "price", "kind": "range", "min": 10, "max": null }, "matches": true },
    { "row": { "pct_day": 5 }, "condition": { "field": "price_change_1d", "kind": "range", "min": 4, "max": null }, "matches": true },
    { "row": { "pct_week": 25 }, "condition": { "field": "perf_week", "kind": "range", "min": 20, "max": null }, "matches": true },
    { "row": { "pct_month": 25 }, "condition": { "field": "perf_month", "kind": "range", "min": 20, "max": null }, "matches": true },
    { "row": { "market_cap": 5000000000, "currency": "USD" }, "condition": { "field": "market_cap_usd", "kind": "range", "min": 1000000000, "max": null }, "matches": true },
    { "row": { "market_cap": 5000000000, "currency": "HKD", "market": "HK" }, "condition": { "field": "market_cap_usd", "kind": "range", "min": 1000000000, "max": null }, "matches": false },
    { "row": { "scan_mode": "listing_only" }, "condition": { "field": "listing_aware_volume", "kind": "range", "min": 100000000, "max": null }, "matches": true },
    { "row": { "symbol": "NVDA", "company_name": "NVIDIA Corp" }, "condition": { "field": "listing_search", "kind": "text", "pattern": "nvidia" }, "matches": true },
    { "note": "Unknown kinds never match.", "row": { "x": 1 }, "condition": { "field": "x", "kind": "weird" }, "matches": false },
    { "note": "Range bounds coerce row strings with JS Number(): \"inf\" and \"1_000\" are NaN, so no bound rejects them.", "row": { "rs_rating": "inf" }, "condition": { "field": "rs_rating", "kind": "range", "min": 70, "max": 99 }, "matches": true },
    { "row": { "rs_rating": "Infinity" }, "condition": { "field": "rs_rating", "kind": "range", "min": 70, "max": 99 }, "matches": false },
    { "row": { "rs_rating": "1_000" }, "condition": { "field": "rs_rating", "kind": "range", "min": 2000, "max": null }, "matches": true },
    { "note": "Number() reads 0x, 0o and 0b prefixes, but not with a sign.", "row": { "rs_rating": "0x10" }, "condition": { "field": "rs_rating", "kind": "range", "min": 20, "max": null }, "matches": false },
    { "row": { "rs_rating": "0b11" }, "condition": { "field": "rs_rating", "kind": "range", "min": 2, "max": 3 }, "matches": true },
    { "row": { "rs_rating": "-0x10" }, "condition": { "field": "rs_rating", "kind": "range", "min": 20, "max": null }, "matches": true },
    { "row": { "rs_rating": "" }, "condition": { "field": "rs_rating", "kind": "range", "min": 70, "max": null }, "matches": false },
    { "note": "Booleans compare as 0 and 1.", "row": { "rs_rating": true }, "condition": { "field": "rs_rating", "kind": "range", "min": 1, "max": 1 }, "matches": true },
    { "note": "A list compares as its comma-joined text: [50] is 50, [] is 0, [80, 90] is NaN.", "row": { "rs_rating": [50] }, "condition": { "field": "rs_rating", "kind": "range", "min": 70, "max": null }, "matches": false },
    { "row": { "rs_rating": [] }, "condition": { "field": "rs_rating", "kind": "range", "min": 70, "max": null }, "matches": false },
    { "row": { "rs_rating": [80, 90] }, "condition": { "field": "rs_rating", "kind": "range", "min": 100, "max": null }, "matches": true },
    { "note": "ISO date ranges compare as text.", "row": { "ipo_date": "2024-06-01" }, "condition": { "field": "ipo_date", "kind": "range", "min": "2024-01-01", "max": "2024-12-31" }, "matches": true },
    { "row": { "ipo_date": "2023-12-31" }, "condition": { "field": "ipo_date", "kind": "range", "min": "2024-01-01", "max": null }, "matches": false },
    { "row": { "ipo_date": "2025-01-01" }, "condition": { "field": "ipo_date", "kind": "range", "min": null, "max": "2024-12-31" }, "matches": false },
    { "row": { "ipo_date": "2024-01-01T09:30:00Z" }, "condition": { "field": "ipo_date", "kind": "range", "min": "2024-01-01", "max": null }, "matches": true },
    { "note": "A one-item list of a date still compares as text.", "row": { "ipo_date": ["2023-01-01"] }, "condition": { "field": "ipo_date", "kind": "range", "min": "2024-01-01", "max": null }, "matches": false },
    { "note": "A number against a date bound is NaN, so it passes.", "row": { "ipo_date": 20230101 }, "condition": { "field": "ipo_date", "kind": "range", "min": "2024-01-01", "max": null }, "matches": true },
    { "note": "Listing-only rows count as infinite volume, so a max rejects them.", "row": { "scan_mode": "listing_only" }, "condition": { "field": "listing_aware_volume", "kind": "range", "min": null, "max": 1000000000 }, "matches": false },
    { "row": { "scan_mode": "listing_only", "volume": 5 }, "condition": { "field": "listing_aware_volume", "kind": "range", "min": 1, "max": 1000000000 }, "matches": false },
    { "row": { "volume": 500000000 }, "condition": { "field": "listing_aware_volume", "kind": "range", "min": null, "max": 1000000000 }, "matches": true },
    { "note": "Text matching formats values with JS String().", "row": { "x": 1.0 }, "condition": { "field": "x", "kind": "text", "pattern": "1.0" }, "matches": false },
    { "row": { "x": -0.0 }, "condition": { "field": "x", "kind": "text", "pattern": "-" }, "matches": false },
    { "row": { "x": 1e16 }, "condition": { "field": "x", "kind": "text", "pattern": "e" }, "matches": false },
    { "row": { "x": 1e21 }, "condition": { "field": "x", "kind": "text", "pattern": "1e+21" }, "matches": true },
    { "row": { "x": 0.00001 }, "condition": { "field": "x", "kind": "text", "pattern": "0.00001" }, "matches": true },
    { "row": { "x": 0.0000001 }, "condition": { "field": "x", "kind": "text", "pattern": "1e-7" }, "matches": true },
    { "row": { "x": 1.5 }, "condition": { "field": "x", "kind": "text", "pattern": "1.5" }, "matches": true },
    { "row": { "x": true }, "condition": { "field": "x", "kind": "text", "pattern": "TRUE" }, "matches": true },
    { "row": { "scan_mode": "listing_only" }, "condition": { "field": "listing_aware_volume", "kind": "text", "pattern": "infinity" }, "matches": true },
    { "row": { "x": ["cup", null, 2.0] }, "condition": { "field": "x", "kind": "text", "pattern": "cup,,2" }, "matches": true },
    { "note": "includes() never finds a list or object by value.", "row": { "p": ["cup"] }, "condition": { "field": "p", "kind": "categorical", "values": [["cup"]], "mode": "include" }, "matches": false },
    { "row": { "p": { "a": 1 } }, "condition": { "field": "p", "kind": "categorical", "values": [{ "a": 1 }], "mode": "exclude" }, "matches": true }
  ],
  "expression": {
    "required": { "match": "all", "conditions": [{ "field": "a", "kind": "range", "min": 1, "max": null }] },
    "groups": [
      { "enabled": true, "match": "all", "conditions": [{ "field": "b", "kind": "boolean", "value": true }] },
      { "enabled": true, "match": "all", "conditions": [{ "field": "c", "kind": "boolean", "value": true }] }
    ]
  },
  "expression_rows": [
    { "group_join": "any", "row": { "a": 1, "b": true }, "matches": true },
    { "group_join": "any", "row": { "a": 1 }, "matches": false },
    { "group_join": "any", "row": { "a": 0, "b": true }, "matches": false },
    { "group_join": "all", "row": { "a": 1, "b": true, "c": true }, "matches": true },
    { "group_join": "all", "row": { "a": 1, "b": true }, "matches": false }
  ],
  "expression_cases": [
    { "note": "A disabled required group fails every row, even when its rules pass.", "expression": { "required": { "enabled": false, "match": "all", "conditions": [{ "field": "a", "kind": "range", "min": 1, "max": null }] }, "groups": [] }, "row": { "a": 1 }, "matches": false },
    { "note": "Only false disables a group; null and a missing key leave it on.", "expression": { "required": { "enabled": null, "match": "all", "conditions": [{ "field": "a", "kind": "range", "min": 1, "max": null }] }, "groups": [] }, "row": { "a": 1 }, "matches": true },
    { "note": "Empty, missing and null groups add no requirement.", "expression": { "required": { "match": "all", "conditions": [{ "field": "a", "kind": "range", "min": 1, "max": null }] }, "groups": [] }, "row": { "a": 1 }, "matches": true },
    { "expression": { "required": { "match": "all", "conditions": [{ "field": "a", "kind": "range", "min": 1, "max": null }] } }, "row": { "a": 1 }, "matches": true },
    { "expression": { "required": { "match": "all", "conditions": [{ "field": "a", "kind": "range", "min": 1, "max": null }] }, "groups": null, "group_join": "all" }, "row": { "a": 1 }, "matches": true },
    { "note": "Disabled optional groups are skipped; when all are disabled the row needs only the required group.", "expression": { "required": { "match": "all", "conditions": [] }, "groups": [{ "enabled": false, "match": "all", "conditions": [{ "field": "b", "kind": "boolean", "value": true }] }] }, "row": {}, "matches": true },
    { "expression": { "required": { "match": "all", "conditions": [] }, "group_join": "any", "groups": [{ "enabled": false, "match": "all", "conditions": [{ "field": "b", "kind": "boolean", "value": true }] }, { "enabled": true, "match": "all", "conditions": [{ "field": "c", "kind": "boolean", "value": true }] }] }, "row": { "b": true }, "matches": false },
    { "expression": { "required": { "match": "all", "conditions": [] }, "group_join": "all", "groups": [{ "enabled": false, "match": "all", "conditions": [{ "field": "b", "kind": "boolean", "value": true }] }, { "enabled": true, "match": "all", "conditions": [{ "field": "c", "kind": "boolean", "value": true }] }] }, "row": { "c": true }, "matches": true },
    { "note": "A group with no rules passes under all and fails under any.", "expression": { "required": { "match": "any", "conditions": [] }, "groups": [] }, "row": {}, "matches": false },
    { "expression": { "required": { "match": "all" }, "groups": [{ "match": "any", "conditions": [] }] }, "row": {}, "matches": false }
  ]
}
